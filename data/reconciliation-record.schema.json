{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mphaxise/gstack-port-for-codex/data/reconciliation-record.schema.json",
  "title": "GStack and GBrain reconciliation manifest",
  "type": "object",
  "required": ["schema_version", "milestone", "reviewed_at", "sources", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "milestone": {"enum": ["alpha", "beta", "complete"]},
    "reviewed_at": {"type": "string", "format": "date"},
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["repo", "adopted_commit", "current_commit"],
        "properties": {
          "repo": {"type": "string", "format": "uri"},
          "adopted_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "current_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        },
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "canonical_id",
          "source_name",
          "upstream_path",
          "local_path",
          "classifications",
          "host_coupling",
          "hashes",
          "retention",
          "intentional_removals",
          "companion_resources",
          "validation",
          "decision"
        ],
        "properties": {
          "canonical_id": {"type": "string", "pattern": "^skill:[a-z0-9-]+$"},
          "source_name": {"enum": ["gstack", "gbrain", "local"]},
          "adopted_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "reviewed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "decision_reason": {"type": "string", "minLength": 1},
          "upstream_path": {"type": ["string", "null"]},
          "local_path": {"type": "string", "pattern": "^skills/.+/SKILL\\.md$"},
          "classifications": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "host_coupling": {"enum": ["portable", "codex-adapter", "runtime-heavy"]},
          "hashes": {
            "type": "object",
            "required": ["adopted_source_sha256", "current_upstream_sha256", "local_sha256"],
            "properties": {
              "adopted_source_sha256": {"type": ["string", "null"]},
              "current_upstream_sha256": {"type": ["string", "null"]},
              "local_sha256": {"type": "string"}
            },
            "additionalProperties": false
          },
          "retention": {
            "type": "object",
            "required": ["basis", "adopted_source_percent", "current_upstream_percent"],
            "properties": {
              "basis": {"const": "normalized-nonblank-line-overlap"},
              "adopted_source_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
              "current_upstream_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
            },
            "additionalProperties": false
          },
          "intentional_removals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["category", "reason"],
              "properties": {
                "category": {"type": "string"},
                "reason": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "companion_resources": {"type": "array", "items": {"type": "string"}},
          "validation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "decision": {"enum": ["adopted", "local-origin", "reviewed-deferred"]}
        },
        "additionalProperties": false
      }
    },
    "alternate_source_records": {
      "description": "Additional upstream lineages for one canonical packaged skill.",
      "type": "array",
      "items": {"type": "object"}
    },
    "resource_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource_id", "source_name", "upstream_path", "local_path", "disposition", "hashes"],
        "properties": {
          "resource_id": {"type": "string", "pattern": "^skill:[a-z0-9-]+:[a-z0-9-]+$"},
          "source_name": {"enum": ["gstack", "gbrain"]},
          "upstream_path": {"type": "string"},
          "local_path": {"type": "string", "pattern": "^skills/.+"},
          "disposition": {"enum": ["host-adapted", "preserved", "reviewed-deferred"]},
          "hashes": {
            "type": "object",
            "required": ["adopted_source_sha256", "current_upstream_sha256", "local_sha256"],
            "properties": {
              "adopted_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "current_upstream_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "local_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "fixture_path", "fixture_sha256", "case_count", "outcomes"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"const": "routing-jsonl"},
          "fixture_path": {"type": "string", "pattern": "^skills/.+\\.jsonl$"},
          "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "case_count": {"type": "integer", "minimum": 1},
          "outcomes": {
            "type": "object",
            "required": ["valid_jsonl", "nonempty_cases", "unique_intents", "expected_skills_packaged", "ambiguous_skills_packaged"],
            "properties": {
              "valid_jsonl": {"type": "boolean"},
              "nonempty_cases": {"type": "boolean"},
              "unique_intents": {"type": "boolean"},
              "expected_skills_packaged": {"type": "boolean"},
              "ambiguous_skills_packaged": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
